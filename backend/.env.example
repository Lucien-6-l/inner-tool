# ===== 服务 =====
PORT=3000
# 生产环境填 https://你的域名
CLIENT_ORIGIN=http://localhost:5173

# ===== 数据库（开发期 SQLite：数据库就是 prisma/dev.db 一个文件）=====
# 生产环境切换 PostgreSQL 示例：
# DATABASE_URL=postgresql://user:pass@localhost:5432/inner_tool
DATABASE_URL=file:./dev.db

# ===== JWT =====
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please_change_me

# ===== 邮件（QQ 邮箱 SMTP）=====
# SMTP 授权码在 QQ 邮箱 设置→账户→开启 SMTP 后获取，不是登录密码
# 未配置时激活链接会打印到后端控制台（开发模式），方便本地调试
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_account@qq.com
SMTP_PASS=your_smtp_auth_code
MAIL_FROM=your_account@qq.com
