// Prisma schema —— 公司内部沟通工具
// 阶段 1：用户 + 预注册名单两张核心表；好友/消息/抽奖等随后续阶段追加

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 角色：DEV=开发者（唯一） ADMIN=管理员 MEMBER=成员
enum Role {
  DEV
  ADMIN
  MEMBER
}

// 预注册名单状态：PENDING 待审批 APPROVED 已通过 REJECTED 已拒绝
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// 员工账号（激活后创建）
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String
  name         String
  department   String
  role         Role     @default(MEMBER)
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations PendingRegistration[] @relation("Reviewer")
}

// 预注册名单：开发者直接录入，或管理员提交后由开发者审批
model PendingRegistration {
  id           String             @id @default(cuid())
  email        String
  phone        String
  name         String
  department   String
  status       RegistrationStatus @default(PENDING)
  rejectReason String?
  // 名单来源：DEV=开发者直接录入 ADMIN=管理员提交待审批
  source       String             @default("DEV") // DEV | ADMIN
  createdById  String
  createdBy    User               @relation("Reviewer", fields: [createdById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@unique([email, department])
  @@index([status])
  @@index([createdById])
}
