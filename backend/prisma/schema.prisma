// Prisma schema —— 公司内部沟通工具
// 阶段 1：用户 + 预注册名单两张核心表；好友/消息/抽奖等随后续阶段追加
//
// 开发期使用 SQLite（零安装）；部署到服务器时把 provider 改回 postgresql、
// DATABASE_URL 改成 PG 连接串即可，表结构无需改动。
// 说明：SQLite 连接器不支持 enum，角色/状态用字符串 + 常量注释代替。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 角色：DEV=开发者（唯一） ADMIN=管理员 MEMBER=成员
// 对应常量：src/constants.ts
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String
  name         String
  department   String
  role         String   @default("MEMBER") // DEV | ADMIN | MEMBER
  passwordHash String
  isActive     Boolean  @default(true)
  avatarUrl    String? // 头像（上传文件的访问 URL）
  bio          String? // 个性标签 / 签名
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations PendingRegistration[] @relation("Reviewer")
  contacts      Contact[]             @relation("Contacts")  // 我加的好友
  friendOf      Contact[]             @relation("FriendOf")  // 加我为好友的人
  memberships   ConversationMember[]
  messages      Message[]
  lotteries     Lottery[]             @relation("LotteryCreator")
  lotteryEntries LotteryEntry[]
  lotteryWinners LotteryWinner[]
  timelinesCreated     Timeline[]            @relation("TimelineCreator")
  timelineParticipants TimelineParticipant[]
  timelineBranches     TimelineBranch[]
  timelineFiles        TimelineFile[]        @relation("FileUploader")
  mergeRequestsCreated MergeRequest[]        @relation("MRCreator")
  mergeRequestsMerged  MergeRequest[]        @relation("MRMerged")
  mergeRequestVotes    MergeRequestVote[]
  mergeRequestComments MergeRequestComment[]
  timelineActivities   TimelineActivity[]
}

// 会话：DIRECT=单聊（好友间） GROUP=部门群（按部门自动生成）
model Conversation {
  id         String   @id @default(cuid())
  kind       String // DIRECT | GROUP
  name       String? // 群名（部门群 = 部门名）
  department String? // 部门群标识（kind=GROUP 时使用）
  createdAt  DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
  lotteries Lottery[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// 消息（必须持久化存储；换设备/清缓存历史不丢）
// type：text=文本 image=图片 file=文件 lottery=抽奖卡片 lottery_result=开奖结果
// readAt：direct 场景接收方读取时间（group 用成员 lastReadAt 算未读）
// senderId 可空：删除成员后保留消息历史（sender 置空，前端显示"已注销"）
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type           String       @default("text") // text | image | file | lottery | lottery_result
  content        String // 文本内容、资源 URL，或 lottery 关联 id / 结果 JSON
  fileName       String?
  fileSize       Int?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// 抽奖（"谁想要"点赞即报名；支持定时自动开奖 / 手动开奖）
// status：PENDING=报名中 DRAWN=已开奖 CANCELLED=已取消
model Lottery {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  creatorId      String
  creator        User     @relation("LotteryCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  title          String // 配文（如"谁想要"）
  fileUrl        String? // 附件：图片或文件 URL
  fileName       String?
  fileSize       Int?
  winnerCount    Int // 开奖人数（发起人设置）
  deadline       DateTime? // 开奖时间（null = 手动开奖）
  status         String   @default("PENDING") // PENDING | DRAWN | CANCELLED
  drawnAt        DateTime?
  createdAt      DateTime @default(now())

  entries LotteryEntry[]
  winners LotteryWinner[]

  @@index([conversationId])
  @@index([status, deadline])
}

// 参与记录（点赞即报名，取消点赞即删除 = 取消资格）
model LotteryEntry {
  id        String   @id @default(cuid())
  lotteryId String
  lottery   Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lotteryId, userId])
}

// 中奖名单
model LotteryWinner {
  id        String   @id @default(cuid())
  lotteryId String
  lottery   Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([lotteryId, userId])
}

// 好友关系（双向：激活成功后自动与同部门同事互加）
// ownerId 主动方视角，好友关系始终成对出现（A->B 与 B->A）
model Contact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("Contacts", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, friendId])
  @@index([friendId])
}

// 预注册名单：开发者直接录入，或管理员提交后由开发者审批
// 状态：PENDING=待审批 APPROVED=已通过 REJECTED=已拒绝
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String
  phone        String
  name         String
  department   String
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?
  // 名单来源：DEV=开发者直接录入 ADMIN=管理员提交待审批
  source       String   @default("DEV") // DEV | ADMIN
  createdById  String
  createdBy    User     @relation("Reviewer", fields: [createdById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([email, department])
  @@index([status])
  @@index([createdById])
}

// ==================== 时间线（项目版本链） ====================
// 一条时间线 = 一个项目；主线为全体参与者共有，每人一个个人分支
// 汇入主线需全体参与者 > 2/3 赞成票

model Timeline {
  id          String   @id @default(cuid())
  name        String // 项目名称
  description String? // 项目描述
  creatorId   String // 项目发起人（必有个人分支，但不一定是投票参与者）
  creator     User     @relation("TimelineCreator", fields: [creatorId], references: [id])
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants TimelineParticipant[]
  branches     TimelineBranch[]
  mergeRequests MergeRequest[]
  activities   TimelineActivity[]

  @@index([creatorId])
  @@index([status])
}

// 时间线参与者（拥有投票权；发起人不一定在此表中）
model TimelineParticipant {
  id         String   @id @default(cuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  @@unique([timelineId, userId])
  @@index([userId])
}

// 分支：isMain=true 为主线（ownerId 为空，全体共有）；isMain=false 为个人分支
model TimelineBranch {
  id         String   @id @default(cuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  ownerId    String? // 个人分支拥有者；主线为空
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  isMain     Boolean  @default(false)
  createdAt  DateTime @default(now())

  files       TimelineFile[]
  mergeRequestsAsSource MergeRequest[] @relation("SourceBranch")
  activities  TimelineActivity[]

  @@index([timelineId])
  @@index([ownerId])
}

// 分支内文件（含版本号，汇入后保留历史）
model TimelineFile {
  id           String   @id @default(cuid())
  branchId     String
  branch       TimelineBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  filename     String
  filePath     String // 服务器存储路径
  fileSize     Int
  mimeType     String
  version      Int // 分支内版本号，同名文件递增
  uploadedById String
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@unique([branchId, filename, version])
  @@index([branchId])
}

// 汇入请求：个人分支 → 主线
// status: pending=投票中 approved=已通过待汇入 rejected=已驳回 merged=已汇入
model MergeRequest {
  id             String   @id @default(cuid())
  timelineId     String
  timeline       Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  sourceBranchId String
  sourceBranch   TimelineBranch @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  title          String
  description    String? // 附带说明
  status         String   @default("pending") // pending | approved | rejected | merged
  createdById    String
  createdBy      User     @relation("MRCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  mergedAt       DateTime?
  mergedById     String?
  mergedBy       User?    @relation("MRMerged", fields: [mergedById], references: [id])
  resubmitCount  Int      @default(0) // 被拒后重新提交次数

  votes    MergeRequestVote[]
  comments MergeRequestComment[]

  @@index([timelineId, status])
  @@index([sourceBranchId])
}

// 投票：approve=赞成 reject=驳回(必填comment) abstain=弃权
model MergeRequestVote {
  id             String   @id @default(cuid())
  mergeRequestId String
  mergeRequest   MergeRequest @relation(fields: [mergeRequestId], references: [id], onDelete: Cascade)
  voterId        String // 必须是 TimelineParticipant
  voter          User     @relation(fields: [voterId], references: [id], onDelete: Cascade)
  vote           String // approve | reject | abstain
  comment        String? // reject 时必填具体问题
  createdAt      DateTime @default(now())

  @@unique([mergeRequestId, voterId])
  @@index([mergeRequestId])
}

// 汇入请求评论讨论
model MergeRequestComment {
  id             String   @id @default(cuid())
  mergeRequestId String
  mergeRequest   MergeRequest @relation(fields: [mergeRequestId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime @default(now())

  @@index([mergeRequestId])
}

// 版本链时间记录：所有操作留痕
// actionType: timeline_created | participant_added | participant_removed |
//   branch_created | file_uploaded | file_deleted | mr_created | mr_voted |
//   mr_approved | mr_rejected | mr_merged | mr_resubmitted | mr_commented
model TimelineActivity {
  id         String   @id @default(cuid())
  timelineId String
  timeline   Timeline @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     TimelineBranch? @relation(fields: [branchId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  detail     String? // JSON 详情
  createdAt  DateTime @default(now())

  @@index([timelineId, createdAt])
}
