// Prisma schema —— 公司内部沟通工具
// 阶段 1：用户 + 预注册名单两张核心表；好友/消息/抽奖等随后续阶段追加
//
// 开发期使用 SQLite（零安装）；部署到服务器时把 provider 改回 postgresql、
// DATABASE_URL 改成 PG 连接串即可，表结构无需改动。
// 说明：SQLite 连接器不支持 enum，角色/状态用字符串 + 常量注释代替。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 角色：DEV=开发者（唯一） ADMIN=管理员 MEMBER=成员
// 对应常量：src/constants.ts
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String
  name         String
  department   String
  role         String   @default("MEMBER") // DEV | ADMIN | MEMBER
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  registrations PendingRegistration[] @relation("Reviewer")
  contacts      Contact[]             @relation("Contacts")  // 我加的好友
  friendOf      Contact[]             @relation("FriendOf")  // 加我为好友的人
  memberships   ConversationMember[]
  messages      Message[]
}

// 会话：DIRECT=单聊（好友间） GROUP=部门群（按部门自动生成）
model Conversation {
  id         String   @id @default(cuid())
  kind       String // DIRECT | GROUP
  name       String? // 群名（部门群 = 部门名）
  department String? // 部门群标识（kind=GROUP 时使用）
  createdAt  DateTime @default(now())

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

// 消息（必须持久化存储；换设备/清缓存历史不丢）
// type：text=文本 image=图片 file=文件
// readAt：direct 场景接收方读取时间（group 用成员 lastReadAt 算未读）
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           String       @default("text") // text | image | file
  content        String // 文本内容或资源 URL
  fileName       String?
  fileSize       Int?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// 好友关系（双向：激活成功后自动与同部门同事互加）
// ownerId 主动方视角，好友关系始终成对出现（A->B 与 B->A）
model Contact {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("Contacts", fields: [ownerId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User     @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ownerId, friendId])
  @@index([friendId])
}

// 预注册名单：开发者直接录入，或管理员提交后由开发者审批
// 状态：PENDING=待审批 APPROVED=已通过 REJECTED=已拒绝
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String
  phone        String
  name         String
  department   String
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason String?
  // 名单来源：DEV=开发者直接录入 ADMIN=管理员提交待审批
  source       String   @default("DEV") // DEV | ADMIN
  createdById  String
  createdBy    User     @relation("Reviewer", fields: [createdById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@unique([email, department])
  @@index([status])
  @@index([createdById])
}
